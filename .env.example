APP_NAME=binlicoder-springboot-template
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
POSTGRES_DB=binlicoder_template
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/binlicoder_template
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_ISSUER=binlicoder-springboot-template
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_TTL=2h
EXTERNAL_API_KEY=replace-with-a-random-api-key
CACHE_MAXIMUM_SIZE=10000
CACHE_TTL=30m
LOG_PATH=./logs
LOG_MAX_FILE_SIZE=100MB
LOG_MAX_HISTORY=14
LOG_TOTAL_SIZE_CAP=2GB
